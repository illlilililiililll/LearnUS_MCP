LEARNUS_ID=
LEARNUS_PASSWORD=
# Enable only explicitly for read-only live tests:
LEARNUS_INTEGRATION=0
LEARNUS_DOWNLOAD_INTEGRATION=0
LEARNUS_MAX_CONCURRENT_REQUESTS=4
LEARNUS_CACHE_ENABLED=1
# Root folder for downloaded files. Leave blank for ~/Documents/LearnUS.
# Windows example: C:\\Users\\your-name\\Downloads\\LearnUS
LEARNUS_DOWNLOAD_ROOT=
# Maximum size of one downloaded file in bytes.
LEARNUS_MAX_DOWNLOAD_BYTES=52428800
# Optional JSON map for audience evidence, e.g. {"123":{"audienceTags":["engineering"]}}
LEARNUS_COURSE_CONTEXT_OVERRIDES=
